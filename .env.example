# ---------------------------------------------------------------------------
# Azure SRE Agent Demo Lab — example environment file
#
# Copy to .env and adjust. .env is git-ignored and MUST NOT be committed.
# Every value here is optional: scripts/deploy.sh will prompt for or derive
# anything that is missing. No secrets belong in this file.
# ---------------------------------------------------------------------------

# --- Azure targeting -------------------------------------------------------
# Subscription to deploy into. Defaults to the current `az account show`.
AZURE_SUBSCRIPTION_ID=
# Azure region, e.g. eastus, westus3, westeurope, uksouth.
AZURE_LOCATION=eastus
# Short suffix that makes resource names unique. Auto-generated when empty.
LAB_SUFFIX=
# Resource group name. Derived from LAB_SUFFIX when empty. The SRE Agent, when
# requested, is created in this same resource group.
RESOURCE_GROUP=

# --- Network access control ------------------------------------------------
# CIDRs permitted to reach SSH (22) on the App VM, the Scenario Controller UI
# and the Magic 8 Ball load balancer. Comma-separated for more than one.
#
# Include the address you will BROWSE from. The machine running deploy.sh is
# often not the same machine (build agent, jump box, CI), and allowing only the
# deploying host produces a lab that deploys cleanly and is unreachable.
# When empty, deploy.sh prompts interactively and offers the detected IP.
# Set to 0.0.0.0/0 only if you accept exposing the demo to the whole Internet.
ADMIN_CIDR=

# --- Sizing (cost guardrails) ----------------------------------------------
APP_VM_SIZE=Standard_B2s
POSTGRES_VM_SIZE=Standard_B2s
# Preferred AKS system node SKU. deploy.sh validates regional availability and
# automatically substitutes a comparable SKU when this one is unavailable.
AKS_NODE_SIZE=Standard_D2as_v7
AKS_BASELINE_NODE_COUNT=1
# Demo data disk attached to the App VM, used by scenario 01 (disk exhaustion).
DEMO_DATA_DISK_GB=16

# --- Kubernetes ------------------------------------------------------------
# Leave empty to let deploy.sh select a currently supported GA version.
AKS_KUBERNETES_VERSION=
K8S_NAMESPACE=sre-demo

# --- Scenario behaviour ----------------------------------------------------
# Automatic safety timeout for an unattended active scenario (minutes).
SCENARIO_TIMEOUT_MINUTES=60
# Allow more than one scenario active simultaneously (not recommended).
ALLOW_CONCURRENT_SCENARIOS=false
# Disk scenario stops filling at this percentage. Never set to 100.
DISK_SCENARIO_TARGET_PERCENT=88

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=sre_demo
POSTGRES_APP_USER=sre_app
POSTGRES_SCENARIO_USER=sre_scenario
# Connection ceiling for the lab. Deliberately modest so scenario 04 is quick.
POSTGRES_MAX_CONNECTIONS=50
# NOTE: passwords are generated at deploy time and stored in Azure Key Vault.
# Never put a password in this file.

# --- Azure SRE Agent -------------------------------------------------------
# Create an Azure SRE Agent as part of the deployment (equivalent to
# --with-agent). Off by default: the agent is a chargeable managed service.
WITH_AGENT=false
# How the agent may act: ReadOnly | Review | Autonomous.
# Review pauses for human approval before each remediation.
AGENT_MODE=Review
# Region for the agent. Defaults to AZURE_LOCATION. SRE Agent is NOT offered in
# eastus, so set this when the lab runs in a region that does not have it.
AGENT_LOCATION=
# Granting the agent write access is deliberately NOT configurable here; run
# scripts/enable-sre-remediation.sh once the agent exists.

# --- GitHub ----------------------------------------------------------------
GITHUB_REPO=F0bsterz/azure-sre-agent-demo-lab
